# Force bare domain, then HTTPS on the host that was requested (keeps beta on beta)
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://therobertrich.com%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

Options -Indexes

# Keep the beta site out of search results (both branches deploy this same file)
SetEnvIfNoCase Host ^beta\. IS_BETA
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow" env=IS_BETA
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Content-Security-Policy "default-src 'none'; script-src 'self' 'sha256-enM37qnBch2GPCaVvr9hpfmLgOaRBEqaKln5AzxT4fE=' 'sha256-zHyWgouC06/kATh4cqXUJtrUs45ib5qhF6VHuPprs48=' 'sha256-EIB6HzzCM7yuZiXW0ZQP7o7eR9AUdhJ80m68dO5SP4Y=' 'sha256-1A8NqzpKswN2tCHHOVs7O2S8AXby/ju09Nv8AZn932w=' https://www.googletagmanager.com; connect-src https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; img-src 'self' https://*.google-analytics.com https://*.googletagmanager.com; style-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
</IfModule>

ErrorDocument 404 /404.html

# Keep CSS/JS fresh: revalidate after an hour instead of a week
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>
